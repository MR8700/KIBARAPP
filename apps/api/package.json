{
  "name": "@kibar/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:dev": "tsc-watch -p tsconfig.json --onSuccess \"node dist/main.js\"",
    "start": "node dist/main.js",
    "prisma:gen": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "@prisma/client": "^5.22.0",
    "@simplewebauthn/server": "^10.0.0",
    "exceljs": "^4.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "pdfkit": "^0.15.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.0",
    "@types/pdfkit": "^0.13.4",
    "@types/ws": "^8.5.10",
    "prisma": "^5.22.0",
    "tsc-watch": "^6.2.0",
    "tsx": "^4.16.0",
    "typescript": "^5.4.5",
    "vite": "^5.3.0",
    "vitest": "^2.0.0"
  }
