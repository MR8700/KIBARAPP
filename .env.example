DATABASE_URL=postgresql://kibar:kibar_dev@localhost:5432/kibar
JWT_SECRET=change-me-long-random
RP_ID=localhost
RP_NAME=KIBAR
WEB_ORIGIN=http://localhost:3000
S3_ENDPOINT=http://localhost:9000
# Adresse du stockage jointe par les navigateurs pour ouvrir/télécharger les documents (en production : https://fichiers.votre-domaine.com)
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=kibar-private
S3_ACCESS_KEY=kibar
S3_SECRET_KEY=kibar_dev_secret
# Antivirus (docker compose up -d clamav ; premier démarrage ≈ 1-2 min le temps de charger les signatures)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# Mettre SCAN_DISABLED=1 uniquement sans ClamAV (fichiers aussitôt « sains »). En production (NODE_ENV=production) il est IGNORÉ et l'API refuse de démarrer s'il est présent : supprimez la ligne.
# NODE_ENV=production
SCAN_DISABLED=1

# Temps réel multi-instances (optionnel : sans cette ligne, diffusion locale à l'instance)
REDIS_URL=redis://localhost:6379
